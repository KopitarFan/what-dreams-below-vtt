{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "what-dreams-below-vtt-local",
  "main": "./worker-entry.mjs",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "what-dreams-below-vtt-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "TOKEN_IMAGES",
      "bucket_name": "what-dreams-below-vtt-local-assets",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-game-rooms",
      "new_sqlite_classes": ["GameRoom"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
